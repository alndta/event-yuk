NODE_ENV=development
PORT=5001
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Wajib di production: minimal 32 karakter acak
JWT_SECRET=
JWT_TTL=12h
ADMIN_EMAILS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pakai kunci SANDBOX selama pengembangan
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
PLATFORM_FEE_PCT=2.5

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Hanya development: kode OTP ikut dikembalikan di respons
EXPOSE_OTP_PREVIEW=true
